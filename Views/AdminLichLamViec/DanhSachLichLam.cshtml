@model List<Doantotnghiep.Models.Entities.LichLamViecNhanVien>

@{
    ViewData["Title"] = "Danh sách lịch làm việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Danh sách lịch làm việc chính thức</h3>
            <p class="text-muted mb-0">Theo dõi lịch làm đã được admin duyệt cho nhân viên</p>
        </div>

        <a asp-action="Index" asp-controller="AdminLichLamViec" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    <div class="mb-3 d-flex gap-2">
        <a asp-action="DanhSachCaLam" asp-controller="AdminLichLamViec" class="btn btn-primary">
            Quản lý ca làm
        </a>

        <a asp-action="DanhSachDangKyca" asp-controller="AdminLichLamViec" class="btn btn-warning">
            Danh sách đăng ký ca
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Lịch làm chính thức</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) lịch
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Nhân viên</th>
                            <th>Tên ca</th>
                            <th>Ngày làm</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Trạng thái lịch</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.NhanVien?.TenNhanVien</strong>
                                    </td>

                                    <td>
                                        @if (item.CaLamViec != null)
                                        {
                                            <span class="fw-semibold">@item.CaLamViec.TenCa</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có thông tin ca</span>
                                        }
                                    </td>

                                    <td>
                                        @item.NgayLamViecNV.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GioBatDauCaLamViecNV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.GioKetThucCaLamViecNV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.TrangThaiLichLamViecNV.ToString() == "DangLam")
                                        {
                                            <span class="badge bg-success">Đang làm</span>
                                        }
                                        else if (item.TrangThaiLichLamViecNV.ToString() == "Nghi")
                                        {
                                            <span class="badge bg-secondary">Nghỉ</span>
                                        }
                                        else if (item.TrangThaiLichLamViecNV.ToString() == "TangCa")
                                        {
                                            <span class="badge bg-primary">Tăng ca</span>
                                        }
                                        else if (item.TrangThaiLichLamViecNV.ToString() == "NghiPhep")
                                        {
                                            <span class="badge bg-danger">Nghỉ phép</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                @item.TrangThaiLichLamViecNV
                                            </span>
                                        }
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Chưa có lịch làm việc nào</h5>
                                        <p class="mb-0">
                                            Khi admin duyệt đăng ký ca, lịch làm chính thức sẽ hiển thị tại đây.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>