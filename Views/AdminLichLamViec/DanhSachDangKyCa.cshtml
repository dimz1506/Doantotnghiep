@model List<Doantotnghiep.Models.ViewModel.LichLamViecViewModel>
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Danh sách đăng ký ca";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Danh sách đăng ký ca</h3>
            <p class="text-muted mb-0">Quản lý các yêu cầu đăng ký ca làm của nhân viên</p>
        </div>

        <a asp-action="Index" asp-controller="AdminLichLamViec" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Thông tin đăng ký ca</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) đăng ký
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Nhân viên</th>
                            <th>Ngày làm</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Trạng thái</th>
                            <th style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.TenNhanVien</strong>
                                    </td>

                                    <td>
                                        @item.NgayLamViec.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GioBatDauLV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.GioKetThucLV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.ChoDuyet)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Chờ duyệt
                                            </span>
                                        }
                                        else if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.DaDuyet)
                                        {
                                            <span class="badge bg-success">
                                                Đã duyệt
                                            </span>
                                        }
                                        else if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.TuChoi)
                                        {
                                            <span class="badge bg-danger">
                                                Từ chối
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.ChoDuyet)
                                        {
                                            <div class="d-flex gap-2">
                                                <a asp-action="DuyetCa"
                                                   asp-controller="AdminLichLamViec"
                                                   asp-route-id="@item.IdLichLamViec"
                                                   class="btn btn-success btn-sm"
                                                   onclick="return confirm('Bạn có chắc muốn duyệt ca này không?');">
                                                    Duyệt
                                                </a>

                                                <a asp-action="TuChoi"
                                                   asp-controller="AdminLichLamViec"
                                                   asp-route-id="@item.IdLichLamViec"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Bạn có chắc muốn từ chối ca này không?');">
                                                    Từ chối
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Đã xử lý</span>
                                        }
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Chưa có đăng ký ca nào</h5>
                                        <p class="mb-0">Khi nhân viên đăng ký ca, dữ liệu sẽ hiển thị tại đây.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <a asp-action="DanhSachCaLam" asp-controller="AdminLichLamViec" class="btn btn-outline-primary">
            Danh sách ca làm
        </a>

        <a asp-action="DanhSachLichLam" asp-controller="AdminLichLamViec" class="btn btn-outline-success">
            Lịch làm chính thức
        </a>
    </div>
</div>