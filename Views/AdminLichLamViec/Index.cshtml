@model List<Doantotnghiep.Models.Entities.LichLamViecNhanVien>

@{
    ViewData["Title"] = "Quản lý lịch làm việc";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tongLich = Model != null ? Model.Count : 0;
    var tongNhanVien = Model != null ? Model.Select(x => x.IdNhanVien).Distinct().Count() : 0;
    var lichGanNhat = Model != null && Model.Any()
        ? Model.OrderByDescending(x => x.NgayLamViecNV).Take(5).ToList()
        : new List<Doantotnghiep.Models.Entities.LichLamViecNhanVien>();
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Quản lý lịch làm việc</h2>
        <p class="text-muted mb-0">
            Theo dõi ca làm, đăng ký ca và lịch làm chính thức của nhân viên
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a asp-action="DanhSachCaLam" asp-controller="AdminLichLamViec"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold text-primary mb-1">Quản lý ca làm</h5>
                                <p class="text-muted mb-0">Tạo và xem danh sách ca làm</p>
                            </div>
                            <div class="fs-2 text-primary">
                                🕒
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-action="DanhSachDangKyca" asp-controller="AdminLichLamViec"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold text-warning mb-1">Duyệt đăng ký ca</h5>
                                <p class="text-muted mb-0">Xác nhận hoặc từ chối ca</p>
                            </div>
                            <div class="fs-2 text-warning">
                                ✅
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-action="DanhSachLichLam" asp-controller="AdminLichLamViec"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold text-success mb-1">Lịch làm chính thức</h5>
                                <p class="text-muted mb-0">Danh sách lịch đã được duyệt</p>
                            </div>
                            <div class="fs-2 text-success">
                                📅
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng lịch làm chính thức</p>
                    <h3 class="fw-bold mb-0">@tongLich</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Số nhân viên có lịch</p>
                    <h3 class="fw-bold mb-0">@tongNhanVien</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">Lịch làm gần đây</h5>
                <small class="text-muted">Hiển thị 5 lịch làm mới nhất</small>
            </div>

            <a asp-action="DanhSachLichLam" asp-controller="AdminLichLamViec"
               class="btn btn-outline-primary btn-sm">
                Xem tất cả
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Nhân viên</th>
                            <th>Ca làm</th>
                            <th>Ngày làm</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (lichGanNhat.Any())
                        {
                            var stt = 1;

                            foreach (var item in lichGanNhat)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.NhanVien?.TenNhanVien</strong>
                                    </td>

                                    <td>
                                        @if (item.CaLamViec != null)
                                        {
                                            <span>@item.CaLamViec.TenCa</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có thông tin ca</span>
                                        }
                                    </td>

                                    <td>@item.NgayLamViecNV.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GioBatDauCaLamViecNV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.GioKetThucCaLamViecNV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.TrangThaiLichLamViecNV.ToString() == "DangLam")
                                        {
                                            <span class="badge bg-success">Đang làm</span>
                                        }
                                        else if (item.TrangThaiLichLamViecNV.ToString() == "Nghi")
                                        {
                                            <span class="badge bg-secondary">Nghỉ</span>
                                        }
                                        else if (item.TrangThaiLichLamViecNV.ToString() == "TangCa")
                                        {
                                            <span class="badge bg-primary">Tăng ca</span>
                                        }
                                        else if (item.TrangThaiLichLamViecNV.ToString() == "NghiPhep")
                                        {
                                            <span class="badge bg-danger">Nghỉ phép</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                @item.TrangThaiLichLamViecNV
                                            </span>
                                        }
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5 class="mb-2">Chưa có lịch làm việc nào</h5>
                                        <p class="mb-3">
                                            Hãy tạo ca làm, cho nhân viên đăng ký và duyệt ca để tạo lịch chính thức.
                                        </p>

                                        <a asp-action="DanhSachCaLam"
                                           asp-controller="AdminLichLamViec"
                                           class="btn btn-primary">
                                            Tạo ca làm ngay
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>