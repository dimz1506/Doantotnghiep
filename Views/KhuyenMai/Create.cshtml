@model Doantotnghiep.Models.ViewModel.KhuyenMaiViewModel
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Tạo khuyến mãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">

            <div class="mb-4">
                <h2 class="fw-bold mb-1">Tạo khuyến mãi</h2>
                <p class="text-muted mb-0">Tạo chương trình khuyến mãi áp dụng cho dịch vụ.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Thông tin khuyến mãi</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenKhuyenMai" class="form-label fw-semibold">Tên khuyến mãi</label>
                            <input asp-for="TenKhuyenMai" class="form-control" />
                            <span asp-validation-for="TenKhuyenMai" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTaKhuyenMai" class="form-label fw-semibold">Mô tả</label>
                            <textarea asp-for="MoTaKhuyenMai" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayBatDau" class="form-label fw-semibold">Ngày bắt đầu</label>
                                <input asp-for="NgayBatDau" type="date" class="form-control" />
                                <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NgayKetThuc" class="form-label fw-semibold">Ngày kết thúc</label>
                                <input asp-for="NgayKetThuc" type="date" class="form-control" />
                                <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LoaiKhuyenMai" class="form-label fw-semibold">Loại khuyến mãi</label>
                                <select asp-for="LoaiKhuyenMai"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<LoaiKhuyenMai>()">
                                </select>
                                <span asp-validation-for="LoaiKhuyenMai" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="GiaTriGiam" class="form-label fw-semibold">Giá trị giảm</label>
                                <input asp-for="GiaTriGiam" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="GiaTriGiam" class="text-danger"></span>
                                <small class="text-muted">
                                    Nếu giảm %, nhập 10 nghĩa là giảm 10%. Nếu giảm tiền, nhập số tiền.
                                </small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Dịch vụ áp dụng</label>
                            <select asp-for="IdDichVus"
                                    asp-items="Model.DichVus"
                                    class="form-select"
                                    multiple>
                            </select>
                            <small class="text-muted">Giữ Ctrl để chọn nhiều dịch vụ.</small>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="TrangThaiKhuyenMai" class="form-check-input" />
                            <label asp-for="TrangThaiKhuyenMai" class="form-check-label">
                                Kích hoạt khuyến mãi
                            </label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-4">Lưu khuyến mãi</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}