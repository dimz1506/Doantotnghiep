@using Doantotnghiep.Models.ViewModel
@model RegisterCustomerVM

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="text-center mb-4">
                <h2 class="fw-bold">Đăng ký tài khoản</h2>
                <p class="text-muted mb-0">
                    Tạo tài khoản khách hàng để đặt lịch và sử dụng dịch vụ
                </p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">Thông tin đăng ký</h5>
                </div>

                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="DangKy" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold">
                                Tên đăng nhập
                            </label>
                            <input asp-for="TenDangNhap"
                                   class="form-control"
                                   placeholder="Nhập tên đăng nhập" />
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email
                            </label>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Nhập email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MatKhau" class="form-label fw-semibold">
                                    Mật khẩu
                                </label>
                                <input asp-for="MatKhau"
                                       type="password"
                                       class="form-control"
                                       placeholder="Nhập mật khẩu" />
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="XacNhanMatKhau" class="form-label fw-semibold">
                                    Nhập lại mật khẩu
                                </label>
                                <input asp-for="XacNhanMatKhau"
                                       type="password"
                                       class="form-control"
                                       placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="TenKhachHang" class="form-label fw-semibold">
                                Tên khách hàng
                            </label>
                            <input asp-for="TenKhachHang"
                                   class="form-control"
                                   placeholder="Nhập họ tên khách hàng" />
                            <span asp-validation-for="TenKhachHang" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold">
                                Số điện thoại
                            </label>
                            <input asp-for="SoDienThoai"
                                   class="form-control"
                                   placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DiaChiKhachHang" class="form-label fw-semibold">
                                Địa chỉ khách hàng
                            </label>
                            <input asp-for="DiaChiKhachHang"
                                   class="form-control"
                                   placeholder="Nhập địa chỉ khách hàng" />
                            <span asp-validation-for="DiaChiKhachHang" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            Đăng ký
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <span class="text-muted">Đã có tài khoản?</span>
                <a asp-action="DangNhap" class="text-decoration-none fw-semibold">
                    Đăng nhập ngay
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}