@using Doantotnghiep.Models.ViewModel
@model LoginVM

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="text-center mb-4">
                <h2 class="fw-bold">Đăng nhập</h2>
                <p class="text-muted mb-0">
                    Vui lòng đăng nhập để tiếp tục sử dụng hệ thống
                </p>
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="alert alert-success text-center">
                    Xin chào <strong>@User.Identity.Name</strong>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">Thông tin tài khoản</h5>
                </div>

                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="DangNhap" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold">
                                Tên tài khoản
                            </label>
                            <input asp-for="TenDangNhap"
                                   class="form-control"
                                   placeholder="Nhập tên tài khoản" />
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MatKhau" class="form-label fw-semibold">
                                Mật khẩu
                            </label>
                            <input asp-for="MatKhau"
                                   type="password"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            Đăng nhập
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <span class="text-muted">Chưa có tài khoản?</span>
                <a asp-action="DangKy" class="text-decoration-none fw-semibold">
                    Đăng ký ngay
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}