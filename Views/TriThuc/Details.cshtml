@model Doantotnghiep.Models.Entities.TriThuc

@{
    ViewData["Title"] = "Chi tiết tri thức";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Chi tiết tri thức</h2>
            <p class="text-muted mb-0">Thông tin dữ liệu được chatbot sử dụng để trả lời.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.TenTriThuc</h5>
        </div>

        <div class="card-body p-4">
            <p><strong>Loại tri thức:</strong> @Model.LoaiTriThuc?.TenLoaiTriThuc</p>
            <p><strong>Từ khóa:</strong> @(Model.TuKhoa ?? "Không có")</p>
            <p><strong>Ngày nhập:</strong> @Model.NgayNhapTriThuc.ToString("dd/MM/yyyy HH:mm")</p>

            <p>
                <strong>Trạng thái:</strong>
                @if (Model.TrangThaiTriThuc)
                {
                    <span class="badge bg-success">Đang dùng</span>
                }
                else
                {
                    <span class="badge bg-secondary">Tạm tắt</span>
                }
            </p>

            <hr />

            <h5 class="fw-bold">Nội dung tri thức</h5>
            <div class="border rounded p-3 bg-light">
                @Model.NoiDungTriThuc
            </div>
        </div>

        <div class="card-footer bg-white d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            <a asp-action="Edit" asp-route-id="@Model.IdTriThuc" class="btn btn-warning">Sửa</a>
        </div>
    </div>
</div>