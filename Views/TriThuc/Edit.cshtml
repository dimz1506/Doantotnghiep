@model Doantotnghiep.Models.Entities.TriThuc

@{
    ViewData["Title"] = "Sửa tri thức";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-9">

            <h2 class="fw-bold mb-4">Sửa tri thức AI</h2>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.IdTriThuc" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdTriThuc" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenTriThuc" class="form-label fw-semibold">Tên tri thức</label>
                            <input asp-for="TenTriThuc" class="form-control" />
                            <span asp-validation-for="TenTriThuc" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdLoaiTriThuc" class="form-label fw-semibold">Loại tri thức</label>
                            <select asp-for="IdLoaiTriThuc" asp-items="ViewBag.LoaiTriThucs" class="form-select">
                                <option value="">-- Chọn loại tri thức --</option>
                            </select>
                            <span asp-validation-for="IdLoaiTriThuc" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TuKhoa" class="form-label fw-semibold">Từ khóa</label>
                            <input asp-for="TuKhoa" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NoiDungTriThuc" class="form-label fw-semibold">Nội dung tri thức</label>
                            <textarea asp-for="NoiDungTriThuc" class="form-control" rows="8"></textarea>
                            <span asp-validation-for="NoiDungTriThuc" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="TrangThaiTriThuc" class="form-check-input" />
                            <label asp-for="TrangThaiTriThuc" class="form-check-label">
                                Cho phép chatbot sử dụng tri thức này
                            </label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-warning">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}