@model List<Doantotnghiep.Models.Entities.TriThuc>

@{
    ViewData["Title"] = "Tri thức AI";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Create" class="btn btn-primary">+ Thêm tri thức</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Loại</th>
                        <th>Từ khóa</th>
                        <th>Trạng thái</th>
                        <th>Ngày nhập</th>
                        <th style="width:220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.TenTriThuc</strong>
                                    <br />
                                    <small class="text-muted">
                                        @(item.NoiDungTriThuc.Length > 80
                                                                        ? item.NoiDungTriThuc.Substring(0, 80) + "..."
                                                                        : item.NoiDungTriThuc)
                            </small>
                        </td>
                        <td>@item.LoaiTriThuc?.TenLoaiTriThuc</td>
                        <td>@(item.TuKhoa ?? "Không có")</td>
                        <td>
                            @if (item.TrangThaiTriThuc)
                                    {
                                        <span class="badge bg-success">Đang dùng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm tắt</span>
                                    }
                                </td>
                                <td>@item.NgayNhapTriThuc.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.IdTriThuc" class="btn btn-info btn-sm">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@item.IdTriThuc" class="btn btn-warning btn-sm">Sửa</a>

                                    <form asp-action="Delete" asp-route-id="@item.IdTriThuc" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa tri thức này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Chưa có tri thức nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>