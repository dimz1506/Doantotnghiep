@model IEnumerable<Doantotnghiep.Models.Entities.DatLich>

@{
    ViewData["Title"] = "Danh sách đặt lịch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Danh sách đặt lịch</h2>
            <p class="text-muted mb-0">
                Quản lý lịch hẹn của khách hàng, nhân viên phụ trách và trạng thái xử lý.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Tạo đặt lịch
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Thông tin đặt lịch</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count() : 0) lịch
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">Mã</th>
                            <th>Khách hàng</th>
                            <th>Nhân viên</th>
                            <th>Ngày hẹn</th>
                            <th>Giờ</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                            <th style="width: 280px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold">#@item.IdDatLich</span>
                                    </td>

                                    <td>
                                        <strong>@item.KhachHang?.TenKhachHang</strong>
                                    </td>

                                    <td>
                                        @if (item.NhanVien != null)
                                        {
                                            <span>@item.NhanVien.TenNhanVien</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có</span>
                                        }
                                    </td>

                                    <td>
                                        @item.NgayHenLich.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <div>
                                            <span class="badge bg-info text-dark">
                                                @item.GioBatDauDV.ToString("HH:mm")
                                            </span>
                                            <span class="mx-1">→</span>
                                            <span class="badge bg-warning text-dark">
                                                @item.GioKetThucDV.ToString("HH:mm")
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.TrangThaiDatLich == Doantotnghiep.Models.Enum.TrangThaiDatLich.ChoXacNhan)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                        }
                                        else if (item.TrangThaiDatLich == Doantotnghiep.Models.Enum.TrangThaiDatLich.DaXacNhan)
                                        {
                                            <span class="badge bg-success">Đã xác nhận</span>
                                        }
                                        else if (item.TrangThaiDatLich == Doantotnghiep.Models.Enum.TrangThaiDatLich.DangThucHien)
                                        {
                                            <span class="badge bg-info text-dark">Đang thực hiện</span>
                                        }
                                        else if (item.TrangThaiDatLich == Doantotnghiep.Models.Enum.TrangThaiDatLich.DaHoanThanh)
                                        {
                                            <span class="badge bg-primary">Đã hoàn thành</span>
                                        }
                                        else if (item.TrangThaiDatLich == Doantotnghiep.Models.Enum.TrangThaiDatLich.DaHuy)
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.TrangThaiDatLich</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.GhiChuDatLich))
                                        {
                                            <span title="@item.GhiChuDatLich">
                                                @(item.GhiChuDatLich.Length > 25
                                                                                    ? item.GhiChuDatLich.Substring(0, 25) + "..."
                                                                                    : item.GhiChuDatLich)
                                </span>
                                                                }
                                        else
                                        {
                                            <span class="text-muted">Không có</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Details"
                                               asp-route-id="@item.IdDatLich"
                                               class="btn btn-info btn-sm">
                                                Chi tiết
                                            </a>

                                            <a asp-action="EditKhachHang"
                                               asp-route-id="@item.IdDatLich"
                                               class="btn btn-warning btn-sm">
                                                Sửa KH
                                            </a>

                                            @if (User.IsInRole("NhanVien") || User.IsInRole("Admin"))
                                            {
                                                <a asp-action="EditNhanVien"
                                                   asp-route-id="@item.IdDatLich"
                                                   class="btn btn-secondary btn-sm">
                                                    Xử lý
                                                </a>
                                            }

                                            @if ((User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                                                                && item.TrangThaiDatLich == Doantotnghiep.Models.Enum.TrangThaiDatLich.ChoXacNhan)
                                            {
                                                <form asp-action="UpdateTrangThai" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.IdDatLich" />
                                                    <input type="hidden" name="trangThai" value="DaXacNhan" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm"
                                                            onclick="return confirm('Bạn có chắc muốn xác nhận lịch này không?');">
                                                        Xác nhận
                                                    </button>
                                                </form>

                                                <form asp-action="UpdateTrangThai" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.IdDatLich" />
                                                    <input type="hidden" name="trangThai" value="DaHuy" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            onclick="return confirm('Bạn có chắc muốn từ chối lịch này không?');">
                                                        Từ chối
                                                    </button>
                                                </form>
                                            }

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.IdDatLich"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Bạn có chắc muốn hủy lịch này không?');">
                                                    Hủy
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Chưa có lịch đặt nào</h5>
                                        <p class="mb-3">
                                            Hãy tạo lịch đặt đầu tiên cho khách hàng.
                                        </p>

                                        <a asp-action="Create" class="btn btn-primary">
                                            + Tạo đặt lịch
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>