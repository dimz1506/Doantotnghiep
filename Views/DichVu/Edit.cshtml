@model Doantotnghiep.Models.Entities.DichVu

@{
    ViewData["Title"] = "Sửa dịch vụ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
{
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-8">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">Sửa dịch vụ</h2>
                        <p class="text-muted mb-0">
                            Cập nhật thông tin dịch vụ trong hệ thống.
                        </p>
                    </div>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ← Quay lại danh sách dịch vụ
                    </a>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">Thông tin dịch vụ</h5>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="Edit" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="IdDichVu" />
                            <input type="hidden" asp-for="NgayTaoDichVu" />
                            <input type="hidden" asp-for="HinhAnhDichVu" />

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="TenDichVu" class="form-label fw-semibold">
                                    Tên dịch vụ
                                </label>

                                <input asp-for="TenDichVu"
                                       class="form-control"
                                       placeholder="Nhập tên dịch vụ" />

                                <span asp-validation-for="TenDichVu" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="IdLoaiDichVu" class="form-label fw-semibold">
                                    Loại dịch vụ
                                </label>

                                <select asp-for="IdLoaiDichVu"
                                        class="form-select"
                                        asp-items="@(ViewBag.LoaiDichVus as SelectList)">
                                    <option value="">-- Chọn loại dịch vụ --</option>
                                </select>

                                <span asp-validation-for="IdLoaiDichVu" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="MoTaDichVu" class="form-label fw-semibold">
                                    Mô tả dịch vụ
                                </label>

                                <textarea asp-for="MoTaDichVu"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Nhập mô tả dịch vụ"></textarea>

                                <span asp-validation-for="MoTaDichVu" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LieuTrinhDichVu" class="form-label fw-semibold">
                                    Liệu trình dịch vụ
                                </label>

                                <textarea asp-for="LieuTrinhDichVu"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Ví dụ: Làm sạch, massage, chăm sóc chuyên sâu..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NguyenLieuSuDung" class="form-label fw-semibold">
                                    Nguyên liệu / sản phẩm sử dụng
                                </label>

                                <textarea asp-for="NguyenLieuSuDung"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Ví dụ: tinh dầu, kem dưỡng, serum, mặt nạ..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="QuyTrinhThucHien" class="form-label fw-semibold">
                                    Quy trình thực hiện
                                </label>

                                <textarea asp-for="QuyTrinhThucHien"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Nhập các bước thực hiện dịch vụ"></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CongCuSuDung" class="form-label fw-semibold">
                                    Công cụ sử dụng
                                </label>

                                <textarea asp-for="CongCuSuDung"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Ví dụ: máy xông hơi, khăn nóng, máy chăm sóc da..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LuuYKhachHang" class="form-label fw-semibold">
                                    Lưu ý cho khách hàng
                                </label>

                                <textarea asp-for="LuuYKhachHang"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Ví dụ: không dùng khi da kích ứng, nên đặt trước..."></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="GiaDichVu" class="form-label fw-semibold">
                                        Giá dịch vụ
                                    </label>

                                    <input asp-for="GiaDichVu"
                                           type="number"
                                           min="0"
                                           class="form-control"
                                           placeholder="Nhập giá dịch vụ" />

                                    <span asp-validation-for="GiaDichVu" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="ThoiLuongDV" class="form-label fw-semibold">
                                        Thời lượng dịch vụ
                                    </label>

                                    <div class="input-group">
                                        <input asp-for="ThoiLuongDV"
                                               type="number"
                                               min="1"
                                               class="form-control"
                                               placeholder="Nhập thời lượng" />

                                        <span class="input-group-text">phút</span>
                                    </div>

                                    <span asp-validation-for="ThoiLuongDV" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="TrangThaiDV" class="form-label fw-semibold">
                                    Trạng thái
                                </label>

                                <select asp-for="TrangThaiDV" class="form-select">
                                    <option value="">-- Chọn trạng thái --</option>
                                    <option value="true">Hoạt động</option>
                                    <option value="false">Không hoạt động</option>
                                </select>

                                <span asp-validation-for="TrangThaiDV" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    Hình ảnh dịch vụ
                                </label>

                                <input type="file"
                                       name="HinhAnhFile"
                                       class="form-control"
                                       accept="image/*"
                                       onchange="previewImage(this)" />

                                <small class="text-muted">
                                    Bỏ trống nếu không muốn thay đổi hình ảnh.
                                </small>

                                <div class="mt-3">
                                    @if (!string.IsNullOrEmpty(Model.HinhAnhDichVu))
                                    {
                                        <img id="previewImg"
                                             src="@Model.HinhAnhDichVu"
                                             alt="Ảnh xem trước"
                                             class="img-thumbnail"
                                             style="max-width: 220px;" />
                                    }
                                    else
                                    {
                                        <img id="previewImg"
                                             src="#"
                                             alt="Ảnh xem trước"
                                             class="img-thumbnail"
                                             style="max-width: 220px; display: none;" />
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    Hủy
                                </a>

                                <button type="submit" class="btn btn-warning px-4">
                                    Cập nhật dịch vụ
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1 text-danger">Xóa dịch vụ</h6>
                            <p class="text-muted mb-0">
                                Thao tác này sẽ xóa dịch vụ khỏi hệ thống.
                            </p>
                        </div>

                        <form asp-action="Delete"
                              asp-route-id="@Model.IdDichVu"
                              method="post"
                              onsubmit="return confirm('Bạn có chắc muốn xóa dịch vụ này?')">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-danger">
                                Xóa dịch vụ
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="alert alert-danger">
            Bạn không có quyền truy cập trang này.
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(input) {
            const previewImg = document.getElementById('previewImg');

            if (!previewImg) {
                return;
            }

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewImg.style.display = 'block';
                };

                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}