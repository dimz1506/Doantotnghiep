@using Microsoft.AspNetCore.Mvc.Rendering
@model List<Doantotnghiep.Models.Entities.DichVu>

@{
    ViewData["Title"] = "Danh sách dịch vụ";
    Layout = (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    var dichVuKhachDatNhieu =
        ViewBag.DichVuKhachDatNhieu as List<Doantotnghiep.Models.ViewModel.DichVuKhachDatNhieuVM>;
}

<div class="container mt-4 mb-5">

    <section class="service-page-hero mb-4">
        <div class="row align-items-center g-4">

            <div class="col-lg-8">
                <h2 class="fw-bold mb-2">
                    Danh sách dịch vụ
                </h2>

                <p class="text-muted mb-0">
                    Tìm kiếm, xem chi tiết và đặt lịch các dịch vụ phù hợp với nhu cầu của bạn.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end">
                <div class="d-flex justify-content-lg-end gap-2 flex-wrap">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            ← Dashboard
                        </a>

                        <a asp-action="Create"
                           class="btn btn-success">
                            + Thêm dịch vụ
                        </a>
                    }
                    else if (User.IsInRole("NhanVien"))
                    {
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            ← Trang chủ
                        </a>

                        <a asp-action="Create"
                           class="btn btn-success">
                            + Thêm dịch vụ
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            ← Trang chủ
                        </a>
                    }

                </div>
            </div>

        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4 service-search-card">
        <div class="card-body p-3 p-md-4">
            <form method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <input type="text"
                               name="searchString"
                               class="form-control form-control-lg"
                               placeholder="Tìm kiếm dịch vụ theo tên hoặc mô tả..."
                               value="@ViewBag.SearchString" />
                    </div>

                    <div class="col-md-4">
                        <select name="idLoaiDichVu"
                                class="form-select form-select-lg"
                                asp-items="@(ViewBag.LoaiDichVus as SelectList)">
                            <option value="">-- Tất cả danh mục --</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Lọc
                        </button>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchString as string) || ViewBag.IdLoaiDichVu != null)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Xóa
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (dichVuKhachDatNhieu != null && dichVuKhachDatNhieu.Any())
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Dịch vụ bạn đặt nhiều nhất</h4>
                <span class="badge bg-primary">Cá nhân hóa theo lịch sử đặt lịch</span>
            </div>

            <div class="row g-3">
                @foreach (var item in dichVuKhachDatNhieu)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            @if (!string.IsNullOrWhiteSpace(item.HinhAnhDichVu))
                            {
                                <img src="@item.HinhAnhDichVu"
                                     class="card-img-top"
                                     style="height:180px; object-fit:cover;"
                                     alt="@item.TenDichVu" />
                            }
                            else
                            {
                                <div class="card-img-top d-flex align-items-center justify-content-center bg-light text-muted"
                                     style="height:180px;">
                                    SPA
                                </div>
                            }

                            <div class="card-body">
                                <h5 class="fw-bold">@item.TenDichVu</h5>

                                <p class="text-muted mb-2">
                                    Bạn đã đặt <strong>@item.SoLanDat</strong> lần
                                </p>

                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-success">
                                        @item.GiaDichVu.ToString("N0") VNĐ
                                    </strong>

                                    <span class="badge bg-light text-dark border">
                                        @item.ThoiLuongDV phút
                                    </span>
                                </div>
                            </div>

                            <div class="card-footer bg-white border-0">
                                <a asp-action="Details"
                                   asp-route-id="@item.IdDichVu"
                                   class="btn btn-outline-primary w-100">
                                    Xem lại dịch vụ
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Tất cả dịch vụ</h4>

        <span class="badge bg-secondary px-3 py-2">
            Tổng: @(Model != null ? Model.Count : 0) dịch vụ
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="service-list-card h-100">

                        <div class="service-list-img-wrap">
                            @if (!string.IsNullOrWhiteSpace(item.HinhAnhDichVu))
                            {
                                <img src="@item.HinhAnhDichVu"
                                     alt="@item.TenDichVu"
                                     class="service-list-img" />
                            }
                            else
                            {
                                <div class="service-list-img-empty">
                                    SPA
                                </div>
                            }

                            <div class="service-list-badge">
                                @item.ThoiLuongDV phút
                            </div>
                        </div>

                        <div class="service-list-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h5 class="fw-bold mb-0">
                                    @item.TenDichVu
                                </h5>

                                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                {
                                    if (item.TrangThaiDV)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ẩn</span>
                                    }
                                }
                            </div>

                            <p class="text-muted service-list-desc mb-3">
                                @if (!string.IsNullOrWhiteSpace(item.MoTaDichVu))
                                {
                                    @(item.MoTaDichVu.Length > 110
                                                            ? item.MoTaDichVu.Substring(0, 110) + "..."
                                                            : item.MoTaDichVu)
                                                }
                                else
                                {
                                    <span>Dịch vụ chăm sóc chuyên nghiệp tại spa.</span>
                                }
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="text-muted small d-block">Giá dịch vụ</span>
                                    <strong class="text-success fs-5">
                                        @item.GiaDichVu.ToString("N0") VNĐ
                                    </strong>
                                </div>

                                <span class="badge bg-light text-dark border">
                                    #@item.IdDichVu
                                </span>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@item.IdDichVu"
                                   class="btn btn-outline-primary flex-fill">
                                    Chi tiết
                                </a>

                                @if (!User.IsInRole("Admin") && !User.IsInRole("NhanVien"))
                                {
                                    <a asp-controller="DatLich"
                                       asp-action="Create"
                                       asp-route-idDichVu="@item.IdDichVu"
                                       class="btn btn-primary flex-fill">
                                        Đặt ngay
                                    </a>
                                }

                                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdDichVu"
                                       class="btn btn-warning">
                                        Sửa
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.IdDichVu"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa dịch vụ này không?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-danger">
                                            Xóa
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center p-5">
                <h5 class="fw-bold">Chưa có dịch vụ nào</h5>
                <p class="text-muted mb-0">
                    Hiện hệ thống chưa có dịch vụ phù hợp để hiển thị.
                </p>
            </div>
        </div>
    }

</div>