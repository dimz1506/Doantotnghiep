@model List<Doantotnghiep.Models.Entities.DichVu>

@{
    ViewData["Title"] = "Danh sách dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">

    <section class="service-page-hero mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <p class="text-uppercase text-primary fw-bold mb-2">
                    Naps Hà Nội Spa
                </p>

                <h2 class="fw-bold mb-2">
                    Dịch vụ chăm sóc và thư giãn
                </h2>

                <p class="text-muted mb-0">
                    Lựa chọn dịch vụ phù hợp, xem giá, thời lượng và đặt lịch nhanh chóng.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end">
                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                {
                    <a asp-action="Create" class="btn btn-success">
                        + Thêm dịch vụ
                    </a>
                }
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4 service-search-card">
        <div class="card-body p-3 p-md-4">
            <form method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-md-9">
                        <input type="text"
                               name="searchString"
                               class="form-control form-control-lg"
                               placeholder="Tìm kiếm dịch vụ theo tên hoặc mô tả..."
                               value="@ViewBag.SearchString" />
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Tìm kiếm
                        </button>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchString as string))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Xóa
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Tất cả dịch vụ</h4>

        <span class="badge bg-secondary px-3 py-2">
            Tổng: @(Model != null ? Model.Count : 0) dịch vụ
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="service-list-card h-100">

                        <div class="service-list-img-wrap">
                            @if (!string.IsNullOrWhiteSpace(item.HinhAnhDichVu))
                            {
                                <img src="@item.HinhAnhDichVu"
                                     alt="@item.TenDichVu"
                                     class="service-list-img" />
                            }
                            else
                            {
                                <div class="service-list-img-empty">
                                    SPA
                                </div>
                            }

                            <div class="service-list-badge">
                                @item.ThoiLuongDV phút
                            </div>
                        </div>

                        <div class="service-list-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h5 class="fw-bold mb-0">
                                    @item.TenDichVu
                                </h5>

                                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                {
                                    if (item.TrangThaiDV)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ẩn</span>
                                    }
                                }
                            </div>

                            <p class="text-muted service-list-desc mb-3">
                                @if (!string.IsNullOrWhiteSpace(item.MoTaDichVu))
                                {
                                    @(item.MoTaDichVu.Length > 110
                                                            ? item.MoTaDichVu.Substring(0, 110) + "..."
                                                            : item.MoTaDichVu)
                                                }
                                else
                                {
                                    <span>Dịch vụ chăm sóc chuyên nghiệp tại spa.</span>
                                }
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="text-muted small d-block">Giá dịch vụ</span>
                                    <strong class="text-success fs-5">
                                        @item.GiaDichVu.ToString("N0") VNĐ
                                    </strong>
                                </div>

                                <span class="badge bg-light text-dark border">
                                    #@item.IdDichVu
                                </span>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@item.IdDichVu"
                                   class="btn btn-outline-primary flex-fill">
                                    Chi tiết
                                </a>

                                @if (!User.IsInRole("Admin") && !User.IsInRole("NhanVien"))
                                {
                                    <a asp-controller="DatLich"
                                       asp-action="Create"
                                       asp-route-idDichVu="@item.IdDichVu"
                                       class="btn btn-primary flex-fill">
                                        Đặt ngay
                                    </a>
                                }

                                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdDichVu"
                                       class="btn btn-warning">
                                        Sửa
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.IdDichVu"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa dịch vụ này không?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-danger">
                                            Xóa
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center p-5">
                <h5 class="fw-bold">Chưa có dịch vụ nào</h5>
                <p class="text-muted mb-0">
                    Hiện hệ thống chưa có dịch vụ phù hợp để hiển thị.
                </p>
            </div>
        </div>
    }

</div>