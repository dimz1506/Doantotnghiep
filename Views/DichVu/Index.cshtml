@model List<Doantotnghiep.Models.Entities.DichVu>
@{
	ViewData["Title"] = "Danh sách dịch vụ";
}
<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Danh sach dich vu</h2>
		<hr />
		<a asp-action="Create" class="btn btn-success mb-3">Thêm mới dịch vụ </a>
	</div>
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success">@TempData["SuccessMessage"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
	}
	<form method="get" class="mb-3">
		<div class="input-group" style="max-width: 400px;">
			<input type="text" name="searchString" class="form-control" placeholder="Tim kiem dich vu .." value="@ViewData["CurrentFilter"]" />
			<button type="submit" class="btn btn-primary">Tim kiem</button>
			@if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
			{
				<a asp-action="Index" class="btn btn-secondary">Xoa bo loc</a>
			}
		</div>
	</form>
	<table class="table table-bordered table-hover">
		<thead class="table-light">
			<tr>
				<th>Id</th>
				<th>Ten dich vu</th>
				<th>Loai dich vu</th>
				<th>Mo ta dich vu</th>
				<th>Gia dich vu</th>
				<th>Thoi luong dich vu</th>
				<th>Trang thai</th>
				<th>Hinh anh</th>
				<th>Hanh dong</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="6" class="text-center">Khong co dich vu nao</td>
				</tr>
			}
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.IdDichVu</td>
					<td>@item.TenDichVu</td>
					<td>@item.LoaiDichVu?.TenLoaiDichVu</td>
					<td>@item.MoTaDichVu</td>
					<td>@item.GiaDichVu</td>
					<td>@item.ThoiLuongDV</td>
					<td>
						@if (item.TrangThaiDV)
						{
							<span class="badge bg-success">Hoat dong</span>
						}
						else
						{
							<span class="badge bg-secondary">Khong hoat dong</span>
						}
					</td>
					<td>
						<img src="@item.HinhAnhDichVu" style="width: 80px; height: 80px; object-fit: cover" />
					</td>
					<td>
						@if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
						{
						<a asp-action="Edit" asp-route-id="@item.IdDichVu" class="btn btn-sm btn-primary">Sua</a>
						<form asp-action="Delete" asp-route-id="@item.IdDichVu" method="post" class="d-inline" onsubmit="return confirm('Ban co chac muon xoa dich vu nay khong?');">
							@Html.AntiForgeryToken()
							<button type="submit" class="btn btn-sm btn-danger">Xoa</button>
						</form>
						}
						<a asp-action="Details" asp-route-id="@item.IdDichVu" class="btn btn-sm btn-info">Chi tiet</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
