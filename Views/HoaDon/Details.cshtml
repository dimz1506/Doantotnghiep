@model Doantotnghiep.Models.Entities.HoaDon
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-action="Index" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Hóa đơn #@Model.IdHoaDon</h5>

            @if (Model.TrangThaiHoaDon == TrangThaiHoaDon.ChuaThanhToan)
            {
                <span class="badge bg-warning text-dark">Chưa thanh toán</span>
            }
            else if (Model.TrangThaiHoaDon == TrangThaiHoaDon.DaThanhToan)
            {
                <span class="badge bg-success">Đã thanh toán</span>
            }
            else
            {
                <span class="badge bg-danger">Đã hủy</span>
            }
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="fw-bold text-primary mb-3">Thông tin khách hàng</h6>

                        <div class="mb-3">
                            <label class="text-muted d-block">Khách hàng</label>
                            <strong>@Model.DatLich?.KhachHang?.TenKhachHang</strong>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted d-block">Nhân viên phụ trách</label>
                            <strong>@Model.DatLich?.NhanVien?.TenNhanVien</strong>
                        </div>

                        <div class="mb-0">
                            <label class="text-muted d-block">Mã lịch đặt</label>
                            <strong>#@Model.IdDatLich</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="fw-bold text-primary mb-3">Thông tin thanh toán</h6>

                        <div class="mb-3">
                            <label class="text-muted d-block">Ngày tạo hóa đơn</label>
                            <strong>@Model.NgayTaoHoaDon.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted d-block">Phương thức thanh toán</label>
                            @if (Model.PhuongThucTT != null)
                            {
                                <strong>@Model.PhuongThucTT</strong>
                            }
                            else
                            {
                                <span class="text-muted">Chưa thanh toán</span>
                            }
                        </div>

                        <div class="mb-0">
                            <label class="text-muted d-block">Ngày thanh toán</label>
                            @if (Model.NgayThanhToan != null)
                            {
                                <strong>@Model.NgayThanhToan.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                            }
                            else
                            {
                                <span class="text-muted">Chưa thanh toán</span>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Chi tiết dịch vụ</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model.ChiTietHoaDons != null ? Model.ChiTietHoaDons.Count : 0) dịch vụ
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Dịch vụ</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Khuyến mãi</th>
                            <th>Tiền giảm</th>
                            <th>Thành tiền sau giảm</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.ChiTietHoaDons != null && Model.ChiTietHoaDons.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model.ChiTietHoaDons)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.DichVu?.TenDichVu</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.SoLuongDV
                                        </span>
                                    </td>

                                    <td>
                                        @item.DonGiaDV.ToString("N0") VNĐ
                                    </td>

                                    <td>
                                        @if (item.KhuyenMai != null)
                                        {
                                            <span class="badge bg-success">
                                                @item.KhuyenMai.TenKhuyenMai
                                            </span>

                                            <br />

                                            @if (item.KhuyenMai.LoaiKhuyenMai == Doantotnghiep.Models.Enum.LoaiKhuyenMai.GiamTheoPhanTram)
                                            {
                                                <small class="text-muted">
                                                    Giảm @item.KhuyenMai.GiaTriGiam%
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">
                                                    Giảm @item.KhuyenMai.GiaTriGiam.ToString("N0") VNĐ
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có</span>
                                        }
                                    </td>

                                    <td>
                                        <strong class="text-danger">
                                            -@item.TienGiam.ToString("N0") VNĐ
                                        </strong>
                                    </td>

                                    <td>
                                        <strong class="text-success">
                                            @item.ThanhTienSauGiam.ToString("N0") VNĐ
                                        </strong>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        Hóa đơn chưa có chi tiết dịch vụ.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <div class="card-footer bg-white">
            <div class="row justify-content-end">
                <div class="col-md-5">

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tổng tiền gốc:</span>
                        <strong>@Model.TongTienGoc.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Giảm giá:</span>
                        <strong>@Model.TongTienGiamGia.ToString("N0") VNĐ</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Tổng thanh toán:</span>
                        <h5 class="text-success fw-bold mb-0">
                            @Model.TongTienSauGiamGia.ToString("N0") VNĐ
                        </h5>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Quay lại
        </a>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                In hóa đơn
            </button>

            @if (Model.TrangThaiHoaDon == TrangThaiHoaDon.ChuaThanhToan)
            {
                <form asp-action="ThanhToan" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="idHoaDon" value="@Model.IdHoaDon" />
                    <input type="hidden" name="phuongThucTT" value="@PhuongThucTT.TienMat" />

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Xác nhận hóa đơn đã thanh toán?');">
                        Xác nhận thanh toán
                    </button>
                </form>
            }
        </div>
    </div>

</div>