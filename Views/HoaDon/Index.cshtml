@model List<Doantotnghiep.Models.Entities.HoaDon>
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Danh sách hóa đơn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Thông tin hóa đơn</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) hóa đơn
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Mã</th>
                            <th>Khách hàng</th>
                            <th>Nhân viên</th>
                            <th>Ngày tạo</th>
                            <th>Tổng tiền gốc</th>
                            <th>Giảm giá</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                            <th style="width: 230px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@item.IdHoaDon</strong>
                                    </td>

                                    <td>
                                        @if (item.DatLich?.KhachHang != null)
                                        {
                                            <strong>@item.DatLich.KhachHang.TenKhachHang</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.DatLich?.NhanVien != null)
                                        {
                                            <span>@item.DatLich.NhanVien.TenNhanVien</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có</span>
                                        }
                                    </td>

                                    <td>
                                        @item.NgayTaoHoaDon.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @item.TongTienGoc.ToString("N0") VNĐ
                                    </td>

                                    <td>
                                        @item.TongTienGiamGia.ToString("N0") VNĐ
                                    </td>

                                    <td>
                                        <strong class="text-success">
                                            @item.TongTienSauGiamGia.ToString("N0") VNĐ
                                        </strong>
                                    </td>

                                    <td>
                                        @if (item.TrangThaiHoaDon == TrangThaiHoaDon.ChuaThanhToan)
                                        {
                                            <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                                        }
                                        else if (item.TrangThaiHoaDon == TrangThaiHoaDon.DaThanhToan)
                                        {
                                            <span class="badge bg-success">Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Details"
                                               asp-route-id="@item.IdHoaDon"
                                               class="btn btn-info btn-sm">
                                                Chi tiết
                                            </a>

                                            @if (item.TrangThaiHoaDon == TrangThaiHoaDon.ChuaThanhToan)
                                            {
                                                <form asp-action="ThanhToan" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="idHoaDon" value="@item.IdHoaDon" />
                                                    <input type="hidden" name="phuongThucTT" value="@PhuongThucTT.TienMat" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm"
                                                            onclick="return confirm('Xác nhận hóa đơn đã thanh toán bằng tiền mặt?');">
                                                        Thanh toán
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Chưa có hóa đơn nào</h5>
                                        <p class="mb-0">
                                            Hóa đơn sẽ được tạo từ lịch đặt đã có dịch vụ.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>