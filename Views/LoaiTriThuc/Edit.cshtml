@model Doantotnghiep.Models.Entities.LoaiTriThuc

@{
    ViewData["Title"] = "Sửa loại tri thức";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <h2 class="fw-bold mb-4">Sửa loại tri thức</h2>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.IdLoaiTriThuc" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdLoaiTriThuc" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenLoaiTriThuc" class="form-label fw-semibold">Tên loại tri thức</label>
                            <input asp-for="TenLoaiTriThuc" class="form-control" />
                            <span asp-validation-for="TenLoaiTriThuc" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTaLoaiTriThuc" class="form-label fw-semibold">Mô tả</label>
                            <textarea asp-for="MoTaLoaiTriThuc" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-warning">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}