@model IEnumerable<Doantotnghiep.Models.Entities.NhanVien>
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Quản lý nhân viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    bool isAdmin = User.IsInRole("Admin");
    bool isAdminOrNhanVien = User.IsInRole("Admin") || User.IsInRole("NhanVien");

    var tongNhanVien = Model != null ? Model.Count() : 0;
    var dangLam = Model != null ? Model.Count(x => x.TrangThaiNV == TrangThaiNhanVien.DangLamViec) : 0;
    var nghiViec = Model != null ? Model.Count(x => x.TrangThaiNV != TrangThaiNhanVien.DangLamViec) : 0;
    var coTaiKhoan = Model != null ? Model.Count(x => x.TaiKhoan != null) : 0;
}

<div class="admin-page">

    <div class="page-header-card mb-4">

        @if (isAdmin)
        {
            <a asp-controller="Admin"
               asp-action="TaoNhanVien"
               class="btn btn-primary btn-lg px-4">
                + Thêm nhân viên
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary-subtle text-primary">👥</div>
                <div>
                    <p class="text-muted mb-1">Tổng nhân viên</p>
                    <h3 class="fw-bold mb-0">@tongNhanVien</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-success-subtle text-success">✅</div>
                <div>
                    <p class="text-muted mb-1">Đang làm việc</p>
                    <h3 class="fw-bold mb-0">@dangLam</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-secondary-subtle text-secondary">⛔</div>
                <div>
                    <p class="text-muted mb-1">Đã nghỉ việc</p>
                    <h3 class="fw-bold mb-0">@nghiViec</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-info-subtle text-info">🔐</div>
                <div>
                    <p class="text-muted mb-1">Có tài khoản</p>
                    <h3 class="fw-bold mb-0">@coTaiKhoan</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="filter-card mb-4">
        <form method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-9">
                    <input type="text"
                           name="searchString"
                           class="form-control form-control-lg"
                           placeholder="Tìm kiếm nhân viên theo tên, địa chỉ, chuyên môn..."
                           value="@ViewData["CurrentFilter"]" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-fill">
                        Tìm kiếm
                    </button>

                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            Xóa
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <div class="content-card">
        <div class="content-card-header">
            <div>
                <h5 class="fw-bold mb-1">Danh sách nhân viên</h5>
                <p class="text-muted mb-0">
                    Danh sách nhân viên hiện có trong hệ thống.
                </p>
            </div>

            <span class="badge bg-dark px-3 py-2">
                Tổng: @tongNhanVien
            </span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <h5 class="fw-bold">Không có nhân viên nào</h5>
                <p class="text-muted mb-3">
                    Hiện chưa có dữ liệu nhân viên phù hợp.
                </p>

                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="TaoNhanVien" class="btn btn-primary">
                        + Thêm nhân viên
                    </a>
                }
            </div>
        }
        else
        {
            <div class="employee-grid">
                @foreach (var item in Model)
                {
                    <div class="employee-card">
                        <div class="employee-top">
                            <div class="employee-avatar">
                                @(string.IsNullOrWhiteSpace(item.TenNhanVien)
                                                        ? "N"
                                                        : item.TenNhanVien.Trim().Substring(0, 1).ToUpper())
                    </div>

                            
                            <div class="info-line">
                                <span class="info-label">💼 Loại</span>
                                <span class="info-value">
                                    @(item.LaNhanVienFullTime ? "Nhân viên Full Time" : "Part Time")
                                </span>
                            </div>


                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <h5 class="fw-bold mb-1">@item.TenNhanVien</h5>
                                        <p class="text-muted small mb-0">Mã nhân viên: #@item.IdNhanVien</p>
                                    </div>

                                    <div class="info-line">
                                        <span class="info-label">🕒 Giờ làm</span>
                                        <span class="info-value">
                                            @item.GioBatDauLamViec.ToString(@"hh\:mm")
                                            -
                                            @item.GioKetThucLamViec.ToString(@"hh\:mm")
                                        </span>
                                    </div>


                            @if (item.TrangThaiNV == TrangThaiNhanVien.DangLamViec)
                                    {
                                        <span class="badge bg-success">Đang làm</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã nghỉ</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="employee-info">
                            <div class="info-line">
                                <span class="info-label">📍 Địa chỉ</span>
                                <span class="info-value">
                                    @(string.IsNullOrWhiteSpace(item.DiaChiNV) ? "Chưa có địa chỉ" : item.DiaChiNV)
                                </span>
                            </div>

                            <div class="info-line">
                                <span class="info-label">💆 Chuyên môn</span>
                                <span class="info-value">
                                    @{
                                        var tenChuyenMon = item.ChuyenMonNV switch
                                        {
                                            "ChamSocDa" => "Chăm sóc da",
                                            "Massage" => "Massage thư giãn",
                                            "GoiDau" => "Gội đầu dưỡng sinh",
                                            "Body" => "Chăm sóc body",
                                            _ => item.ChuyenMonNV
                                        };
                                    }

                                    @tenChuyenMon
                                </span>
                            </div>

                            <div class="info-line">
                                <span class="info-label">📅 Ngày tạo</span>
                                <span class="info-value">@item.NgayTaoNV.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            @if (isAdmin)
                            {
                                <div class="info-line">
                                    <span class="info-label">🔐 Tài khoản</span>
                                    <span class="info-value">
                                        @if (item.TaiKhoan != null)
                                        {
                                            <span class="badge bg-info text-dark">
                                                @item.TaiKhoan.TenTaiKhoan
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có</span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="employee-actions">
                            @if (isAdminOrNhanVien)
                            {
                                <a asp-action="Details"
                                   asp-route-id="@item.IdNhanVien"
                                   class="btn btn-outline-primary flex-fill">
                                    Chi tiết
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.IdNhanVien"
                                   class="btn btn-primary flex-fill">
                                    Sửa
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Không có quyền</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>