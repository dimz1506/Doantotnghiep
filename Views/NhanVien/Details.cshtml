@model Doantotnghiep.Models.Entities.NhanVien
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Chi tiết thông tin nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isAdmin = User.IsInRole("Admin");
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Chi tiết nhân viên</h2>
                    <p class="text-muted mb-0">
                        Xem thông tin cá nhân, chuyên môn và trạng thái làm việc của nhân viên.
                    </p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin nhân viên</h5>

                    <span class="badge bg-light text-dark">
                        #@Model.IdNhanVien
                    </span>
                </div>

                <div class="card-body p-4">

                    <div class="mb-3">
                        <label class="text-muted d-block">Tên nhân viên</label>
                        <h5 class="fw-bold mb-0">@Model.TenNhanVien</h5>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted d-block">Địa chỉ</label>
                        @if (!string.IsNullOrWhiteSpace(Model.DiaChiNV))
                        {
                            <strong>@Model.DiaChiNV</strong>
                        }
                        else
                        {
                            <span class="text-muted">Chưa có địa chỉ</span>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="text-muted d-block">Chuyên môn</label>
                        @if (!string.IsNullOrWhiteSpace(Model.ChuyenMonNV))
                        {
                            <strong>@Model.ChuyenMonNV</strong>
                        }
                        else
                        {
                            <span class="text-muted">Chưa có chuyên môn</span>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="text-muted d-block">Ngày tạo</label>
                        <strong>@Model.NgayTaoNV.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted d-block">Trạng thái</label>

                        @if (Model.TrangThaiNV == TrangThaiNhanVien.DangLamViec)
                        {
                            <span class="badge bg-success">
                                Đang làm việc
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Đã nghỉ việc
                            </span>
                        }
                    </div>

                    @if (isAdmin)
                    {
                        <hr />

                        <div class="mb-0">
                            <label class="text-muted d-block">Tài khoản liên kết</label>

                            @if (Model.TaiKhoan != null)
                            {
                                <span class="badge bg-info text-dark">
                                    @Model.TaiKhoan.TenTaiKhoan
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa liên kết tài khoản</span>
                            }
                        </div>
                    }
                </div>

                <div class="card-footer bg-white d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Quay lại
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.IdNhanVien"
                       class="btn btn-primary">
                        Sửa thông tin
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>