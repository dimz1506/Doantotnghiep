@model Doantotnghiep.Models.Entities.HoiThoaiAI

@{
    ViewData["Title"] = "Chi tiết hội thoại";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var tinNhans = Model.TinNhanAIs.OrderBy(x => x.thoiGianGui).ToList();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-action="Index" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Khách hàng:</strong> @(Model.KhachHang?.TenKhachHang ?? "Khách vãng lai")
            <br />
            <strong>Trạng thái:</strong> @Model.TrangThaiHoiThoai
        </div>

        <div class="card-body bg-light" style="height: 500px; overflow-y:auto;">
            @foreach (var tin in tinNhans)
            {
                if (tin.VaiTro == "User")
                {
                    <div class="d-flex justify-content-start mb-3">
                        <div class="bg-white border p-3 rounded-3" style="max-width:75%;">
                            <div>@tin.NoiDung</div>
                            <small class="text-muted">@tin.thoiGianGui.ToString("HH:mm dd/MM")</small>
                        </div>
                    </div>
                }
                else if (tin.VaiTro == "NhanVien")
                {
                    <div class="d-flex justify-content-end mb-3">
                        <div class="bg-success text-white p-3 rounded-3" style="max-width:75%;">
                            <div>@tin.NoiDung</div>
                            <small class="text-white-50">@tin.thoiGianGui.ToString("HH:mm dd/MM")</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-start mb-3">
                        <div class="bg-secondary text-white p-3 rounded-3" style="max-width:75%;">
                            <div>@tin.NoiDung</div>
                            <small class="text-white-50">@tin.thoiGianGui.ToString("HH:mm dd/MM")</small>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="card-footer bg-white">
            @if (Model.TrangThaiHoiThoai == "ChoNhanVien" && Model.IdNhanVien == null)
            {
                <form asp-action="TiepNhan"
                      asp-route-id="@Model.IdHoiThoaiAI"
                      method="post"
                      class="mb-3">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-success">
                        Tiếp nhận hội thoại
                    </button>
                </form>
            }

            @if (Model.TrangThaiHoiThoai == "DaChuyenNhanVien")
            {
                <form asp-action="TraLoi" method="post" class="mb-3">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="idHoiThoaiAI" value="@Model.IdHoiThoaiAI" />

                    <div class="input-group">
                        <input type="text"
                               name="noiDung"
                               class="form-control"
                               placeholder="Nhập nội dung trả lời khách..." />

                        <button type="submit" class="btn btn-primary">
                            Gửi
                        </button>
                    </div>
                </form>

                <form asp-action="KetThuc"
                      asp-route-id="@Model.IdHoiThoaiAI"
                      method="post"
                      onsubmit="return confirm('Bạn có chắc muốn kết thúc hội thoại này?');">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Kết thúc hội thoại
                    </button>
                </form>
            }
        </div>
    </div>
</div>