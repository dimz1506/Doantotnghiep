@model List<Doantotnghiep.Models.Entities.CaLamViec>

@{
    ViewData["Title"] = "Đăng ký ca làm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Đăng ký ca làm</h2>
            <p class="text-muted mb-0">
                Chọn ca làm đang mở để gửi yêu cầu đăng ký cho admin duyệt.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="LichSuDangKy"
               asp-controller="NhanVienDangKyCa"
               class="btn btn-outline-info">
                Lịch sử đăng ký
            </a>

            <a asp-action="LichLamCuaToi"
               asp-controller="NhanVienDangKyCa"
               class="btn btn-outline-success">
                Lịch làm của tôi
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Danh sách ca đang mở đăng ký</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) ca
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Tên ca</th>
                            <th>Ngày làm</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Số lượng tối đa</th>
                            <th>Trạng thái</th>
                            <th style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.TenCa</strong>
                                    </td>

                                    <td>
                                        @item.NgayLam.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GioBatDau.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.GioKetThuc.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.SoLuongNhanVienToiDa nhân viên
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.MoDangKy)
                                        {
                                            <span class="badge bg-success">
                                                Đang mở
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Đã đóng
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.MoDangKy)
                                        {
                                            <form asp-action="DangKyCa"
                                                  asp-controller="NhanVienDangKyCa"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="idCaLamViec"
                                                       value="@item.IdCaLamViec" />

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm"
                                                        onclick="return confirm('Bạn có chắc muốn đăng ký ca này không?');">
                                                    Đăng ký
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Không thể đăng ký
                                            </span>
                                        }
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Chưa có ca làm nào đang mở đăng ký</h5>
                                        <p class="mb-0">
                                            Vui lòng quay lại sau hoặc liên hệ admin để được tạo ca làm.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-3 mb-0">
        Sau khi đăng ký, yêu cầu của bạn sẽ ở trạng thái chờ duyệt. Khi admin duyệt, ca làm sẽ xuất hiện trong mục “Lịch làm của tôi”.
    </div>

</div>