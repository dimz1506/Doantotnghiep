@model List<Doantotnghiep.Models.ViewModel.LichLamViecViewModel>

@{
    ViewData["Title"] = "Lịch làm của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lịch làm của tôi</h2>
            <p class="text-muted mb-0">
                Danh sách các ca làm đã được admin duyệt chính thức.
            </p>
        </div>

        <a asp-action="Index"
           asp-controller="NhanVienDangKyCa"
           class="btn btn-outline-secondary">
            Quay lại đăng ký ca
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Danh sách lịch làm</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) lịch
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Ngày làm</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.NgayLamViec.ToString("dd/MM/yyyy")</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GioBatDauLV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.GioKetThucLV.ToString("HH:mm")
                                        </span>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Bạn chưa có lịch làm chính thức</h5>
                                        <p class="mb-3">
                                            Khi admin duyệt ca đăng ký, lịch làm của bạn sẽ hiển thị tại đây.
                                        </p>

                                        <a asp-action="Index"
                                           asp-controller="NhanVienDangKyCa"
                                           class="btn btn-primary">
                                            Đăng ký ca làm
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-3 mb-0">
        Chỉ những ca đã được admin duyệt mới xuất hiện trong danh sách lịch làm chính thức.
    </div>

</div>