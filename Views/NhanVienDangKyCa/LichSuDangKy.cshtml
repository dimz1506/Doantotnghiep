@model List<Doantotnghiep.Models.ViewModel.LichLamViecViewModel>
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Lịch sử đăng ký ca";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lịch sử đăng ký ca</h2>
            <p class="text-muted mb-0">
                Theo dõi trạng thái các ca làm bạn đã gửi đăng ký.
            </p>
        </div>

        <a asp-action="Index"
           asp-controller="NhanVienDangKyCa"
           class="btn btn-outline-secondary">
            Quay lại đăng ký ca
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Danh sách đăng ký ca</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) đăng ký
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Ngày làm</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.NgayLamViec.ToString("dd/MM/yyyy")</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GioBatDauLV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.GioKetThucLV.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.ChoDuyet)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Chờ duyệt
                                            </span>
                                        }
                                        else if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.DaDuyet)
                                        {
                                            <span class="badge bg-success">
                                                Đã duyệt
                                            </span>
                                        }
                                        else if (item.TrangThaiDangKyCaLam == TrangThaiDangKyCaLam.TuChoi)
                                        {
                                            <span class="badge bg-danger">
                                                Từ chối
                                            </span>
                                        }
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Bạn chưa đăng ký ca nào</h5>
                                        <p class="mb-3">
                                            Hãy chọn ca làm đang mở để gửi yêu cầu đăng ký.
                                        </p>

                                        <a asp-action="Index"
                                           asp-controller="NhanVienDangKyCa"
                                           class="btn btn-primary">
                                            Đăng ký ca làm
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-3 mb-0">
        Trạng thái “Chờ duyệt” nghĩa là yêu cầu của bạn đang đợi admin xác nhận.
    </div>

</div>