@model List<Doantotnghiep.Models.Entities.ThongBao>

@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container mt-4 mb-5">

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Nội dung</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.TieuDe</strong></td>
                                <td>@item.NoiDung</td>
                                <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.DaDoc)
                                    {
                                        <span class="badge bg-secondary">Đã đọc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Mới</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="DocThongBao"
                                       asp-route-id="@item.IdThongBao"
                                       class="btn btn-primary btn-sm">
                                        Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Bạn chưa có thông báo nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>