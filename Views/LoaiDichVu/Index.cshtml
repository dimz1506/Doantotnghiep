@model List<Doantotnghiep.Models.Entities.LoaiDichVu>

@{
    ViewData["Title"] = "Danh sách loại dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Danh sách loại dịch vụ</h2>
            <p class="text-muted mb-0">
                Quản lý các nhóm loại dịch vụ trong hệ thống.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Thêm loại dịch vụ
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-md-8">
                        <input type="text"
                               name="searchString"
                               class="form-control"
                               placeholder="Tìm kiếm loại dịch vụ..."
                               value="@ViewData["CurrentFilter"]" />
                    </div>

                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Tìm kiếm
                        </button>

                        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Xóa bộ lọc
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Thông tin loại dịch vụ</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count : 0) loại
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">Mã</th>
                            <th>Tên loại dịch vụ</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th style="width: 170px;">Hành động</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Không có loại dịch vụ nào</h5>
                                        <p class="mb-3">
                                            Hãy thêm loại dịch vụ đầu tiên để phân loại dịch vụ.
                                        </p>

                                        <a asp-action="Create" class="btn btn-success">
                                            + Thêm loại dịch vụ
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold">#@item.IdLoaiDichVu</span>
                                    </td>

                                    <td>
                                        <strong>@item.TenLoaiDichVu</strong>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.MoTaLoaiDichVu))
                                        {
                                            <span title="@item.MoTaLoaiDichVu">
                                                @(item.MoTaLoaiDichVu.Length > 45
                                                                                    ? item.MoTaLoaiDichVu.Substring(0, 45) + "..."
                                                                                    : item.MoTaLoaiDichVu)
                                </span>
                                                                }
                                        else
                                        {
                                            <span class="text-muted">Không có mô tả</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.TrangThaiLoaiDV)
                                        {
                                            <span class="badge bg-success">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Không hoạt động
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.NgayTaoLoaiDichVu.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdLoaiDichVu"
                                               class="btn btn-primary btn-sm">
                                                Sửa
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.IdLoaiDichVu"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa loại dịch vụ này không?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>