@model List<Doantotnghiep.Models.Entities.LoaiDichVu>
@{
	ViewData["Title"] = "Danh sách loại dịch vụ";
}
<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Danh sach loai dich vu</h2>
		<hr />
		<a asp-action="Create" class="btn btn-success mb-3">Thêm mới loại dịch vụ </a>
	</div>
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success">@TempData["SuccessMessage"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
	}
	<form method="get" class="mb-3">
		<div class="input-group" style="max-width: 400px;">
			<input type="text" name="searchString" class="form-control" placeholder="Tim kiem loai dich vu .." value="@ViewData["CurrentFilter"]" />
			<button type="submit" class="btn btn-primary">Tim kiem</button>
			@if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
			{
				<a asp-action="Index" class="btn btn-secondary">Xoa bo loc</a>
			}
		</div>
	</form>
	<table class="table table-bordered table-striped">
		<thead class="table-light">
			<tr>
				<th>Id</th>
				<th>Tên loại dịch vụ</th>
				<th>Mô tả loại dịch vụ</th>
				<th>Trạng thái</th>
				<th>Ngày tạo</th>
				<th>Hành động</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="6" class="text-center">Khong co loai dich vu nao</td>
				</tr>
			}
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.IdLoaiDichVu</td>
					<td>@item.TenLoaiDichVu</td>
					<td>@item.MoTaLoaiDichVu</td>
					<td>
						@if (item.TrangThaiLoaiDV)
						{
							<span class="badge bg-success">Hoat dong</span>
						}
						else
						{
							<span class="badge bg-secondary">Khong hoat dong</span>
						}
					</td>
					<td>@item.NgayTaoLoaiDichVu.ToString("dd/MM/yyyy")</td>
					<td>
						<a asp-action="Edit" asp-route-id="@item.IdLoaiDichVu" class="btn btn-primary btn-sm">Sua</a>
						<form asp-action="Delete" asp-route-id="@item.IdLoaiDichVu" method="post" class="d-inline" onsubmit="return confirm('Ban co chac muon xoa?');">
							<button type="submit" class="btn btn-danger btn-sm">Xoa</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
