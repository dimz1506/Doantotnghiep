@model Doantotnghiep.Models.Entities.LoaiDichVu

@{
    ViewData["Title"] = "Sửa loại dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Sửa loại dịch vụ</h2>
                    <p class="text-muted mb-0">
                        Cập nhật tên, mô tả và trạng thái loại dịch vụ.
                    </p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Thông tin loại dịch vụ</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdLoaiDichVu" />
                        <input type="hidden" asp-for="NgayTaoLoaiDichVu" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenLoaiDichVu" class="form-label fw-semibold">
                                Tên loại dịch vụ
                            </label>

                            <input asp-for="TenLoaiDichVu"
                                   class="form-control"
                                   placeholder="Nhập tên loại dịch vụ" />

                            <span asp-validation-for="TenLoaiDichVu" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTaLoaiDichVu" class="form-label fw-semibold">
                                Mô tả loại dịch vụ
                            </label>

                            <textarea asp-for="MoTaLoaiDichVu"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Nhập mô tả loại dịch vụ"></textarea>

                            <span asp-validation-for="MoTaLoaiDichVu" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TrangThaiLoaiDV" class="form-label fw-semibold">
                                Trạng thái
                            </label>

                            <select asp-for="TrangThaiLoaiDV" class="form-select">
                                <option value="">-- Chọn trạng thái --</option>
                                <option value="true">Hoạt động</option>
                                <option value="false">Không hoạt động</option>
                            </select>

                            <span asp-validation-for="TrangThaiLoaiDV" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Hủy
                            </a>

                            <button type="submit" class="btn btn-warning px-4">
                                Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                Loại dịch vụ sau khi cập nhật sẽ ảnh hưởng đến các dịch vụ đang thuộc nhóm này.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}