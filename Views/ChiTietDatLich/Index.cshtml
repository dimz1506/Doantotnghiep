@model IEnumerable<Doantotnghiep.Models.Entities.ChiTietDatLich>

@{
    ViewData["Title"] = "Danh sách chi tiết đặt lịch";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var idDatLich = ViewBag.IdDatLich;
    var tongTien = Model != null ? Model.Sum(x => x.GiaDichVu * x.SoLuong) : 0;
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Danh sách chi tiết đặt lịch</h2>
            <p class="text-muted mb-0">
                Quản lý các dịch vụ trong lịch đặt hiện tại.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-idDatLich="@idDatLich"
           class="btn btn-primary">
            + Thêm dịch vụ
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Thông tin dịch vụ</strong>

            <span class="badge bg-secondary">
                Tổng: @(Model != null ? Model.Count() : 0) dịch vụ
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Tên dịch vụ</th>
                            <th>Giá dịch vụ</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>@item.DichVu?.TenDichVu</strong>
                                    </td>

                                    <td>
                                        @item.GiaDichVu.ToString("N0") VNĐ
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.SoLuong
                                        </span>
                                    </td>

                                    <td>
                                        <strong class="text-success">
                                            @((item.GiaDichVu * item.SoLuong).ToString("N0")) VNĐ
                                        </strong>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdChiTietDatLich"
                                               class="btn btn-warning btn-sm">
                                                Sửa
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.IdChiTietDatLich"
                                               class="btn btn-danger btn-sm">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>Chưa có dịch vụ nào</h5>
                                        <p class="mb-3">
                                            Hãy thêm dịch vụ vào lịch đặt này.
                                        </p>

                                        <a asp-action="Create"
                                           asp-route-idDatLich="@idDatLich"
                                           class="btn btn-primary">
                                            + Thêm dịch vụ
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <h5 class="mb-0">
                        Tổng tiền:
                        <span class="text-success fw-bold">
                            @tongTien.ToString("N0") VNĐ
                        </span>
                    </h5>

                    <div class="d-flex gap-2">
                        <a asp-controller="DatLich"
                           asp-action="Details"
                           asp-route-id="@idDatLich"
                           class="btn btn-outline-secondary">
                            Quay lại lịch đặt
                        </a>

                        @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                        {
                            <form asp-controller="HoaDon"
                                  asp-action="TaoHoaDon"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="idDatLich" value="@idDatLich" />

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Bạn có chắc muốn tạo hóa đơn cho lịch đặt này không?');">
                                    Tạo hóa đơn
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

</div>