@model Doantotnghiep.Models.ViewModel.ChiTietDatLichViewModel

@{
    ViewData["Title"] = "Sửa chi tiết đặt lịch";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Thông tin chi tiết đặt lịch</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdChiTietDatLich" />
                        <input type="hidden" asp-for="IdDatLich" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="IdDichVu" class="form-label fw-semibold">
                                Dịch vụ
                            </label>

                            <select asp-for="IdDichVu"
                                    asp-items="Model.DichVus"
                                    class="form-select">
                                <option value="">-- Chọn dịch vụ --</option>
                            </select>

                            <span asp-validation-for="IdDichVu" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SoLuong" class="form-label fw-semibold">
                                Số lượng
                            </label>

                            <input asp-for="SoLuong"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Nhập số lượng" />

                            <span asp-validation-for="SoLuong" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index"
                               asp-route-idDatLich="@Model.IdDatLich"
                               class="btn btn-outline-secondary">
                                Quay lại
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                Sau khi cập nhật, thông tin chi tiết đặt lịch sẽ được thay đổi theo dịch vụ và số lượng mới.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}