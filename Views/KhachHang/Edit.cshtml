@model Doantotnghiep.Models.ViewModel.EditKhachHangViewModel
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Sửa thông tin khach hang";
}
    <div class="container mt-4">
        <h2>Sửa thông tin Khach hang</h2>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdKhachHang" />
            <input type="hidden" asp-for="NgayTaoKH" />

            <div class="mb-3">
                <label class="form-label">Tên Khach Hang</label>
                <input asp-for="TenKhachHang" class="form-control" />
                <span asp-validation-for="TenKhachHang" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                <input asp-for="DiaChiKhachHang" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Ghi chu:</label>
				<input asp-for="GhiChuKH" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Ngày tạo</label>
                <input asp-for="NgayTaoKH" class="form-control" readonly />
            </div>
           
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
