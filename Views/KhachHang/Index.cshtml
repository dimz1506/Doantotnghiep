@model IEnumerable<Doantotnghiep.Models.Entities.KhachHang>
@using Doantotnghiep.Models.Enum

@{
    ViewData["Title"] = "Quản lý Khach Hang";
    bool isAdminOrNV = User.IsInRole("Admin") || User.IsInRole("NhanVien");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách khach hang</h2>  

		@if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
		{	
    <form method="get" class="mb-3">
        <div class="input-group" style="max-width: 400px;">
            <input type="text" name="searchString" class="form-control"
                   placeholder="Tìm kiếm khach hang..."
                   value="@ViewData["CurrentFilter"]" />
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
            {
                <a asp-action="Index" class="btn btn-secondary">Xóa bộ lọc</a>
            }
        </div>
    </form>
    }
    </div>

    <div class="container mt-4">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
					@if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
					{
					
                <th>ID</th>
                    }
                <th>Tên khach hang</th>
                <th>Địa chỉ</th>
                <th>Ghi chu</th>
					@if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
					{
                <th>Ngày tạo</th>
                <th>Tài khoản</th>
                    }
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center">Không có khach hang nào</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
							@if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
							{
                        <td>@item.IdKhachHang</td>
                            }
                        <td>@item.TenKhachHang</td>
                        <td>@item.DiaChiKhachHang</td>
                        <td>@item.GhiChuKH</td>
                        @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                        {
                                <td>@item.NgayTaoKH.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.TaiKhoan?.TenTaiKhoan</td>
                        }
                        <td>
                         <a asp-action="Edit" asp-route-id="@item.IdKhachHang" class="btn btn-sm btn-primary">Sửa</a>
                         <a asp-action="Details" asp-route-id="@item.IdKhachHang" class="btn btn-sm btn-info">Chi tiết</a>
                         
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>