@model List<Doantotnghiep.Models.ViewModel.ThongKe.DoanhThuTheoThangViewModel>

@{
    ViewData["Title"] = "Doanh thu theo tháng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Năm</label>
                    <input type="number"
                           name="nam"
                           value="@ViewBag.Nam"
                           class="form-control"
                           min="2000"
                           max="2100" />
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    @{
        var tongDoanhThu = Model != null ? Model.Sum(x => x.DoanhThu) : 0;
        var tongHoaDon = Model != null ? Model.Sum(x => x.SoHoaDon) : 0;
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng doanh thu năm @ViewBag.Nam</p>
                    <h3 class="fw-bold text-success mb-0">
                        @tongDoanhThu.ToString("N0") VNĐ
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng hóa đơn đã thanh toán</p>
                    <h3 class="fw-bold mb-0">
                        @tongHoaDon
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Bảng doanh thu theo tháng</strong>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tháng</th>
                        <th>Năm</th>
                        <th>Số hóa đơn</th>
                        <th>Doanh thu</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>Tháng @item.Thang</td>
                                <td>@item.Nam</td>
                                <td>@item.SoHoaDon</td>
                                <td>
                                    <strong class="text-success">
                                        @item.DoanhThu.ToString("N0") VNĐ
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Không có dữ liệu doanh thu trong năm này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>