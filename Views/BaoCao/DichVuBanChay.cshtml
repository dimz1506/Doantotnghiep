@model List<Doantotnghiep.Models.ViewModel.ThongKe.DichVuBanChayViewModel>

@{
    ViewData["Title"] = "Dịch vụ bán chạy";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Từ ngày</label>
                    <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Đến ngày</label>
                    <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    @{
        var tongSoLuong = Model != null ? Model.Sum(x => x.TongSoLuong) : 0;
        var tongDoanhThu = Model != null ? Model.Sum(x => x.DoanhThu) : 0;
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng số lượng dịch vụ bán ra</p>
                    <h3 class="fw-bold mb-0">@tongSoLuong</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng doanh thu dịch vụ</p>
                    <h3 class="fw-bold text-success mb-0">
                        @tongDoanhThu.ToString("N0") VNĐ
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Bảng thống kê dịch vụ bán chạy</strong>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Mã DV</th>
                        <th>Tên dịch vụ</th>
                        <th>Tổng số lượng</th>
                        <th>Doanh thu</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.IdDichVu</td>
                                <td>
                                    <strong>@item.TenDichVu</strong>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.TongSoLuong
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-success">
                                        @item.DoanhThu.ToString("N0") VNĐ
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Chưa có dữ liệu dịch vụ bán chạy.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>