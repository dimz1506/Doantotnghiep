@model List<Doantotnghiep.Models.ViewModel.ThongKe.NhanVienThongKeViewModel>

@{
    ViewData["Title"] = "Thống kê nhân viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Từ ngày</label>
                    <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Đến ngày</label>
                    <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    @{
        var tongLich = Model != null ? Model.Sum(x => x.TongLichPhuTrach) : 0;
        var tongHoanThanh = Model != null ? Model.Sum(x => x.LichHoanThanh) : 0;
        var tongDoanhThu = Model != null ? Model.Sum(x => x.DoanhThu) : 0;
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng lịch phụ trách</p>
                    <h3 class="fw-bold mb-0">@tongLich</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng lịch hoàn thành</p>
                    <h3 class="fw-bold text-primary mb-0">@tongHoanThanh</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Tổng doanh thu</p>
                    <h3 class="fw-bold text-success mb-0">
                        @tongDoanhThu.ToString("N0") VNĐ
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Bảng thống kê nhân viên</strong>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Mã NV</th>
                        <th>Nhân viên</th>
                        <th>Tổng lịch phụ trách</th>
                        <th>Lịch hoàn thành</th>
                        <th>Doanh thu</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.IdNhanVien</td>

                                <td>
                                    <strong>@item.TenNhanVien</strong>
                                </td>

                                <td>@item.TongLichPhuTrach</td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.LichHoanThanh
                                    </span>
                                </td>

                                <td>
                                    <strong class="text-success">
                                        @item.DoanhThu.ToString("N0") VNĐ
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Chưa có dữ liệu thống kê nhân viên.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>